{
  "dictionaries": [
    {
      "name": "CUI-Banner-Structural",
      "description": "Well-formed CUI banner line with category marking (Basic or Specified).",
      "customPhraseMatchType": "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY",
      "patterns": [
        {
          "action": "PATTERN_COUNT_TYPE_ALL",
          "pattern": "\\bCUI//(SP-)?[A-Z]{2,10}\\b"
        }
      ],
      "phrases": [],
      "_tier": 1,
      "_min_match_count": 1,
      "_intended_action": "Block",
      "_notes": "Single pattern covers both Basic (CUI//PRVCY) and Specified (CUI//SP-CTI). Do not add a separate SP- pattern - it double-counts the same marking."
    },
    {
      "name": "CUI-Banner-LDC",
      "description": "CUI banner carrying a limited dissemination control segment.",
      "customPhraseMatchType": "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY",
      "patterns": [
        {
          "action": "PATTERN_COUNT_TYPE_ALL",
          "pattern": "\\bCUI//([A-Z-]{2,12}//)?(NOFORN|FEDCON|NOCON|PROPIN|DISPLAY ONLY|REL TO|FED ONLY|DL ONLY)\\b"
        }
      ],
      "phrases": [],
      "_tier": 1,
      "_min_match_count": 1,
      "_intended_action": "Block"
    },
    {
      "name": "CUI-PortionMark-Structural",
      "description": "CUI portion markings in parenthetical form.",
      "customPhraseMatchType": "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY",
      "patterns": [
        {
          "action": "PATTERN_COUNT_TYPE_ALL",
          "pattern": "\\((CUI|CUI//(SP-)?[A-Z]{2,10})\\)"
        }
      ],
      "phrases": [],
      "_tier": 1,
      "_min_match_count": 2,
      "_intended_action": "Block",
      "_notes": "Min count 2 at rule level - a single parenthetical is FP-prone."
    },
    {
      "name": "CUI-Basic-Bare",
      "description": "Bare CUI designation with no category segment (Basic CUI).",
      "customPhraseMatchType": "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY",
      "patterns": [
        {
          "action": "PATTERN_COUNT_TYPE_ALL",
