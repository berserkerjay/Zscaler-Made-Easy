<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the signed macOS standalone build
     (tools/build_standalone.py, release-standalone.yml). Only one exception:
     ctypes and cffi (used by the cryptography package) create executable
     memory for callbacks. No JIT, no library-validation bypass, no
     sandbox escapes. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
