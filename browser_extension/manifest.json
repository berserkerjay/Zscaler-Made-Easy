{
  "manifest_version": 3,
  "name": "Zscaler Made Easy companion",
  "short_name": "Zscaler Made Easy",
  "version": "1.2.0",
  "description": "Works with the Zscaler Made Easy app on this computer: badges in the ZIA admin console on DLP objects, policy rules, URL categories and the objects rules use, a side panel with what uses them and their findings, DLP export as JSON or Terraform, and the Path analyzer for any site.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zscaler Made Easy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://admin.zscaler.net/*",
    "https://admin.zscalerone.net/*",
    "https://admin.zscalertwo.net/*",
    "https://admin.zscalerthree.net/*",
    "https://admin.zscloud.net/*",
    "https://admin.zscalerten.net/*",
    "https://admin.zscalerbeta.net/*",
    "https://admin.zscalergov.net/*",
    "https://admin.zscalergov.us/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:* http://localhost:*"
  }
}
