[
  {
    "name": "ZBP-[DLP] Block Source Code Uploads",
    "description": "Blocks uploads containing Python, JavaScript, or shell-script source code to AI/ML applications. Application scope is resolved from the tenant's AI_ML catalogue at deploy time.",
    "action": "BLOCK",
    "state": "DISABLED",
    "rank": 7,
    "engines": [
      "ZBP-JavaScript Code Detection Engine",
      "ZBP-Python Code Detection Engine",
      "ZBP-Shell Script Detection Engine"
    ],
    "protocols": [
      "WEBSOCKETSSL_RULE",
      "WEBSOCKET_RULE",
      "FTP_RULE",
      "HTTPS_RULE",
      "HTTP_RULE"
    ],
    "cloud_app_classes": ["AI_ML"],
    "severity": "RULE_SEVERITY_INFO"
  },
  {
    "name": "ZBP-[CAC] AI Apps: Block File Upload",
    "channel": "cloud_app",
    "description": "Cloud App Control: on AI & ML applications, allow browsing and prompts but block file upload regardless of content. The containment layer in front of the DLP rule above.",
    "state": "DISABLED",
    "rank": 7,
    "type": "AI_ML",
    "cloud_app_classes": ["AI_ML"],
    "actions_by_verb": {"UPLOAD": "BLOCK", "*": "ALLOW"},
    "device_trust_levels": ["UNKNOWN_DEVICETRUSTLEVEL", "LOW_TRUST", "MEDIUM_TRUST", "HIGH_TRUST"]
  },
  {
    "name": "ZBP-[SSL] Decrypt AI Apps",
    "channel": "ssl",
    "description": "SSL Inspection: decrypt traffic to AI & ML applications so the source-code DLP rule can inspect uploads.",
    "state": "DISABLED",
    "rank": 7,
    "action": {
      "type": "DECRYPT",
      "override_default_certificate": false,
      "ssl_interception_cert": {"id": 1, "default_certificate": true},
