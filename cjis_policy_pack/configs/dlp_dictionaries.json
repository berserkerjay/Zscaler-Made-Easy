  {
    "name": "CJIS Marking Pattern (High Confidence)",
    "description": "Explicit CJIS / CJI / CHRI portion and banner markings (document header/footer or paragraph portion markings).",
    "custom_phrase_match_type": "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY",
