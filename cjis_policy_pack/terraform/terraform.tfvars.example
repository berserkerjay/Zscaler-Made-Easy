# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it contains credentials.

zia_username = "admin@agency.gov"
zia_password = ""
zia_api_key  = ""
zia_cloud    = "zscalergov"

aws_region   = "us-gov-west-1"

# Start with ALLOW (monitor), flip to BLOCK after tuning
policy_action = "ALLOW"
policy_state  = "ENABLED"
policy_rank   = 7
