  {
    "name": "CA-SIN",
    "description": "Canadian Social Insurance Number: nine digits (first digit 1-7 or 9) with dash, space or no separators, within 50 bytes of an English or French SIN label. The Luhn check cannot be expressed in a ZIA pattern, so the label is required to keep plain nine-digit numbers out.",
    "custom_phrase_match_type": "MATCH_CUSTOM_ANY_PATTERN_WITH_ANY_PHRASE",
    "proximity": 50,
    "patterns": [
      {
        "action": "PATTERN_COUNT_TYPE_UNIQUE",
        "pattern": "\\b[1-79]\\d{2}-\\d{3}-\\d{3}\\b"
      },
      {
        "action": "PATTERN_COUNT_TYPE_UNIQUE",
        "pattern": "\\b[1-79]\\d{2} \\d{3} \\d{3}\\b"
      },
      {
        "action": "PATTERN_COUNT_TYPE_UNIQUE",
        "pattern": "\\b[1-79]\\d{8}\\b"
