# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Environment
.env
*.env
venv/
.venv/
# A venv that is a symlink (worktrees) is a file to git, so ignore that too.
venv
.venv

# Credentials
tenant_config.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local run artifacts
*.log

# Tenant profiles (local, may hold remembered secrets) and their saved snapshots
tenant_profiles.json
tenant_snapshots/

# Silent launcher output
server.log
launcher.log

# Machine-specific settings (proxy, CA bundle, credentials)
local_settings.bat
local_settings.env
deployments.json
# The install's key for classic-API tenant fingerprints (tenant_fingerprint.py)
tenant_fingerprint.key
zia_rate_state.json*
.zia_rate-*
ui_token.txt
audit.log*

# Policy packs added from Advanced settings (local library)
user_packs/
updater_backup/
# Continuous evaluation: the per-tenant approval queue (local, never committed)
proposals.json
proposals.json.tmp
proposals.json.lock
# The team change queue (change_queue.py): requests, its lock file and atomic-write temporaries
change_requests.json
change_requests.json.lock
.change_requests.*.tmp
# Workspace notes (workspace_notes.py): tags, comments and to-dos, its lock file and atomic-write temporaries
workspace_notes.json
workspace_notes.json.lock
.workspace_notes.*.tmp
# POVs (pov.py): one per tenant profile, in povs/ beside the profiles, with templates and the lock
povs/
# Continuous evaluation: digests, guidance state and the refreshed SaaS matrix (local)
digests/
guidance_state.json
guidance_state.json.tmp
saas_apps.local.json
checks_config.json.tmp

# Local launcher state (start.sh --background)
server.pid

# Organisation root certificates for the container build (certs/README.md)
certs/*.crt
certs/*.pem
certs/*.cer
update_container.log
posture_settings.json
# Self-healing (self_heal.py): its state, last-good copies of the stores and damaged files moved aside
self_heal.json
*.last-good
*.corrupt-*
.selfheal-*.tmp
# Atomic-write temporaries of the stores that hold secrets or tenant data: a
# crash between the write and the rename leaves one behind (tenant profiles
# can hold a remembered secret, the UI token file the token, the fingerprint
# key the install's key), so it is never committed.
.profiles-*
.ui_token_*
.fingerprint-*
.deployments-*
.posture-*
# Local settings of update notifications and local plugins (update_notify.py, local_plugins.py)
update_notify.json
plugins.json
# Their atomic-write temporaries (a crash between the write and the rename leaves one behind)
.update-notify-*
.plugins-*
# Scheduled sync jobs (sync_jobs.py): jobs and history, its lock file and atomic-write temporaries
sync_jobs.json
sync_jobs.json.lock
.sync_jobs.*.tmp
# Configuration backups, the configuration cache and templates (config_backup.py): tenant configuration, beside the profiles
config_backups/

# Store encryption (store_crypto.py): the key file, the one-time migration's
# journal and its plaintext safety backup, and their atomic-write temporaries.
# The key beside the data must never be committed or baked into an image.
store_keys.json
.store_keys.json.*.tmp
store_encryption_migration.json
.store_encryption_migration.json.*.tmp
store-encryption-backup/

# Agent workspace run outputs (agent-workspace/output/README.md explains them)
agent-workspace/output/*
!agent-workspace/output/README.md
