  description                = "SaaS Security API: the same detection as the inline rule \"Bank-Financial Information-Monitor\" (ZBP-Financial Information). Monitor-only; enable after reviewing incidents. [DLP-Check baseline global_banking_baseline v1.1] Terraform-managed."
  order                      = var.rule_starting_order + 10
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "OFLCASB_DLP_REPORT_INCIDENT"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  type                       = "OFLCASB_DLP_FILE"
  collaboration_scope        = ["ANY"]
  dlp_engines {
    id = [zia_dlp_engines.zbp_financial_information.id]
  }
  cloud_app_tenants {
    id = lookup(var.saas_tenant_ids, "Bank-Financial [SaaS]", var.saas_tenant_ids_default)
  }
  lifecycle {
    precondition {
      condition     = length(lookup(var.saas_tenant_ids, "Bank-Financial [SaaS]", var.saas_tenant_ids_default)) > 0
      error_message = "Rule Bank-Financial [SaaS]: set saas_tenant_ids[\"Bank-Financial [SaaS]\"] or saas_tenant_ids_default to the ids of the onboarded SaaS application tenants (Administration > SaaS Application Tenants), or run a preflight in DLP-Check to have them resolved by name."
    }
  }
}

