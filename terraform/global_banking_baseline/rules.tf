# Generated by DLP-Check from policy pack global_banking_baseline v1.1 for zscaler/zia ~> 4.8.

# Rules — one resource per pack policy. New rules take var.rule_starting_order + N in their channel.

resource "zia_dlp_web_rules" "bank_payment_card_data_monitor" {
  name                       = "Bank-Payment Card Data-Monitor"
  description                = "Inline Web DLP: payment card data (PAN with CVV/PIN/expiry, several card numbers, magnetic tracks). Monitor-only to start; OCR on so photographed cards and scanned forms are inspected. Move to BLOCK after tuning. [DLP-Check baseline global_banking_baseline v1.1] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  protocols                  = ["WEBSOCKETSSL_RULE", "WEBSOCKET_RULE", "FTP_RULE", "HTTPS_RULE", "HTTP_RULE"]
  dlp_engines {
    id = [zia_dlp_engines.bank_payment_card_data.id]
  }
}

