# Generated by DLP-Check from pack cjis_policy_pack v1.2 for zscaler/zia ~> 4.8.

# Rules — one resource per pack policy. New rules take var.rule_starting_order + N in their channel.

resource "zia_dlp_web_rules" "z_cjis_markings_monitor" {
  name                       = "Z-CJIS Markings-Monitor"
  description                = "Monitor outbound content with explicit CJIS / CHRI / LES markings. Covers banner and portion markings anywhere in the document. [${var.assessor} pack cjis_policy_pack v1.2] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  protocols                  = ["WEBSOCKETSSL_RULE", "WEBSOCKET_RULE", "FTP_RULE", "HTTPS_RULE", "HTTP_RULE"]
  dlp_engines {
    id = [zia_dlp_engines.cjis_markings_high_confidence.id]
  }
}

