  description                             = "CUI designation indicator block field labels in close proximity. Tier 5 designation block; intended action Caution; min matches 3. [${var.assessor} pack fed_policy_pack v2.1] Terraform-managed."
  dictionary_type                         = "PATTERNS_AND_PHRASES"
  custom                                  = true
  custom_phrase_match_type                = "MATCH_CUSTOM_ANY_PATTERN_WITH_ANY_PHRASE"
  proximity                               = 600
  proximity_enabled_for_custom_dictionary = true
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\bCUI\\b"
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_ALL"
    phrase = "\"Controlled by\""
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_ALL"
    phrase = "\"CUI Category\""
  }
  phrases {
