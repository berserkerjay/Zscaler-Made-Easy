      error_message = "Rule Z-Atomic Energy Act [SaaS]: set saas_tenant_ids[\"Z-Atomic Energy Act [SaaS]\"] or saas_tenant_ids_default to the ids of the onboarded SaaS application tenants (Administration > SaaS Application Tenants), or run a preflight in Zscaler Made Easy to have them resolved by name."
