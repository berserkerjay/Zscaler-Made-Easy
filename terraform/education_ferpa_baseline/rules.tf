# Generated by Zscaler Made Easy from pack education_ferpa_baseline v1.0 for zscaler/zia ~> 4.8.

# Rules — one resource per pack policy. New rules take var.rule_starting_order + N in their channel.

resource "zia_dlp_web_rules" "edu_markings_monitor" {
  name                       = "EDU-Markings-Monitor"
  description                = "Monitor outbound content labelled as education records (FERPA citation or the words Education Record). [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  protocols                  = ["WEBSOCKETSSL_RULE", "WEBSOCKET_RULE", "FTP_RULE", "HTTPS_RULE", "HTTP_RULE"]
  dlp_engines {
    id = [zia_dlp_engines.edu_record_markings.id]
  }
}

resource "zia_dlp_web_rules" "edu_student_record_data_monitor" {
  name                       = "EDU-Student-Record-Data-Monitor"
  description                = "Monitor outbound student record data: a transcript, grade or aid record name with an SSN nearby. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 1
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  protocols                  = ["WEBSOCKETSSL_RULE", "WEBSOCKET_RULE", "FTP_RULE", "HTTPS_RULE", "HTTP_RULE"]
  dlp_engines {
    id = [zia_dlp_engines.edu_student_record_data.id]
  }
}

resource "zia_endpoint_dlp_rules" "edu_markings_endpoint" {
  name                       = "EDU-Markings [Endpoint]"
  description                = "Endpoint DLP: the same detection as the inline rule \"EDU-Markings-Monitor\" (EDU Record Markings). Monitor-only; enable after reviewing incidents. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  device_trust_levels        = ["UNKNOWN_DEVICETRUSTLEVEL", "LOW_TRUST", "MEDIUM_TRUST", "HIGH_TRUST"]
  data_transfer_method       = "REMOVABLE_DRIVE_TRANSFER"
  user_risk_score_levels     = ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
  eun_enabled                = false
  dlp_engines {
    id = [zia_dlp_engines.edu_record_markings.id]
  }
}

resource "zia_casb_dlp_rules" "edu_markings_saas" {
  name                       = "EDU-Markings [SaaS]"
  description                = "SaaS Security API: the same detection as the inline rule \"EDU-Markings-Monitor\" (EDU Record Markings). Monitor-only; enable after reviewing incidents. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "OFLCASB_DLP_REPORT_INCIDENT"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  type                       = "OFLCASB_DLP_FILE"
  collaboration_scope        = ["ANY"]
  dlp_engines {
    id = [zia_dlp_engines.edu_record_markings.id]
  }
  cloud_app_tenants {
    id = lookup(var.saas_tenant_ids, "EDU-Markings [SaaS]", var.saas_tenant_ids_default)
  }
  lifecycle {
    precondition {
      condition     = length(lookup(var.saas_tenant_ids, "EDU-Markings [SaaS]", var.saas_tenant_ids_default)) > 0
      error_message = "Rule EDU-Markings [SaaS]: set saas_tenant_ids[\"EDU-Markings [SaaS]\"] or saas_tenant_ids_default to the ids of the onboarded SaaS application tenants (Administration > SaaS Application Tenants), or run a preflight in Zscaler Made Easy to have them resolved by name."
    }
  }
}

resource "zia_outbound_email_dlp" "edu_markings_email" {
  name                       = "EDU-Markings [Email]"
  description                = "Email DLP: the same detection as the inline rule \"EDU-Markings-Monitor\" (EDU Record Markings). Monitor-only; enable after reviewing incidents. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 0
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  dlp_engines {
    id = [zia_dlp_engines.edu_record_markings.id]
  }
  dynamic "email_tenants" {
    for_each = length(lookup(var.email_tenant_ids, "EDU-Markings [Email]", var.email_tenant_ids_default)) > 0 ? [1] : []
    content {
      id = lookup(var.email_tenant_ids, "EDU-Markings [Email]", var.email_tenant_ids_default)
    }
  }
}

