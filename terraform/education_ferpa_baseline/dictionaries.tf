# Generated by Zscaler Made Easy from pack education_ferpa_baseline v1.0 for zscaler/zia ~> 4.8.

# Dictionaries — generated from the pack; predefined Zscaler dictionaries are looked up by name.

data "zia_dlp_dictionaries" "social_security_numbers_us" {
  name = "Social Security Numbers (US)"
}

resource "zia_dlp_dictionaries" "edu_record_markings" {
  name                     = "EDU-Record-Markings"
  description              = "Education record labels: the FERPA citation (20 U.S.C. 1232g, 34 CFR Part 99) and the words Education Record or Student Record. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  dictionary_type          = "PATTERNS_AND_PHRASES"
  custom                   = true
  custom_phrase_match_type = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b34\\s?C\\.?F\\.?R\\.?\\s*(?:Part\\s*)?99\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b20\\s?U\\.?S\\.?C\\.?\\s*§?\\s*1232g\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b(?:EDUCATION|STUDENT)\\s+RECORDS?\\b"
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_ALL"
    phrase = "\"FERPA PROTECTED\""
  }
}

resource "zia_dlp_dictionaries" "edu_student_record_terms" {
  name                     = "EDU-Student-Record-Terms"
  description              = "Names of documents that hold student record data: transcripts, grade reports, financial aid and disability service records. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  dictionary_type          = "PATTERNS_AND_PHRASES"
  custom                   = true
  custom_phrase_match_type = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b(?:Official|Unofficial)?\\s*(?:Academic\\s+)?Transcript\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b(?:Grade\\s+Report|Report\\s+Card|Cumulative\\s+GPA|Academic\\s+Standing)\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b(?:Financial\\s+Aid|FAFSA|Disciplinary)\\s+(?:Award|Record|Letter|Hearing)?\\b"
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_UNIQUE"
    phrase = "\"individualized education program\""
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_UNIQUE"
    phrase = "\"student id\""
  }
}

resource "zia_dlp_dictionaries" "edu_social_security_numbers_us_prox_500" {
  name                                 = "EDU-Social Security Numbers (US) - Prox 500"
  description                          = "Cloned predefined SSN dictionary with 500-character proximity, used WITH the student record terms so only SSNs in student records fire. [${var.assessor} pack education_ferpa_baseline v1.0] Terraform-managed."
  dictionary_type                      = "PATTERNS_AND_PHRASES"
  custom                               = true
  custom_phrase_match_type             = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  dict_template_id                     = data.zia_dlp_dictionaries.social_security_numbers_us.id
  confidence_level_for_predefined_dict = "CONFIDENCE_LEVEL_HIGH"
  confidence_threshold                 = "CONFIDENCE_LEVEL_HIGH"
  proximity                            = 500
}

