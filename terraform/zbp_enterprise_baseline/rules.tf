  description                = "Endpoint DLP: the same detection as the inline rule \"ZBP-US PII-Monitor\" (ZBP-US PII). Monitor-only; enable after reviewing incidents. [${var.assessor} baseline zbp_enterprise_baseline v1.1] Terraform-managed."
  order                      = var.rule_starting_order + 5
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  device_trust_levels        = ["UNKNOWN_DEVICETRUSTLEVEL", "LOW_TRUST", "MEDIUM_TRUST", "HIGH_TRUST"]
  data_transfer_method       = "REMOVABLE_DRIVE_TRANSFER"
  user_risk_score_levels     = ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
  eun_enabled                = false
  dlp_engines {
    id = [zia_dlp_engines.zbp_us_pii.id]
  }
}

resource "zia_casb_dlp_rules" "zbp_us_pii_saas" {
  name                       = "ZBP-US PII [SaaS]"
  description                = "SaaS Security API: the same detection as the inline rule \"ZBP-US PII-Monitor\" (ZBP-US PII). Monitor-only; enable after reviewing incidents. [${var.assessor} baseline zbp_enterprise_baseline v1.1] Terraform-managed."
  order                      = var.rule_starting_order + 5
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "OFLCASB_DLP_REPORT_INCIDENT"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  type                       = "OFLCASB_DLP_FILE"
  collaboration_scope        = ["ANY"]
  dlp_engines {
    id = [zia_dlp_engines.zbp_us_pii.id]
  }
  cloud_app_tenants {
    id = lookup(var.saas_tenant_ids, "ZBP-US PII [SaaS]", var.saas_tenant_ids_default)
  }
  lifecycle {
    precondition {
      condition     = length(lookup(var.saas_tenant_ids, "ZBP-US PII [SaaS]", var.saas_tenant_ids_default)) > 0
      error_message = "Rule ZBP-US PII [SaaS]: set saas_tenant_ids[\"ZBP-US PII [SaaS]\"] or saas_tenant_ids_default to the ids of the onboarded SaaS application tenants (Administration > SaaS Application Tenants), or run a preflight in Zscaler Made Easy to have them resolved by name."
    }
  }
}

resource "zia_outbound_email_dlp" "zbp_us_pii_email" {
  name                       = "ZBP-US PII [Email]"
  description                = "Email DLP: the same detection as the inline rule \"ZBP-US PII-Monitor\" (ZBP-US PII). Monitor-only; enable after reviewing incidents. [${var.assessor} baseline zbp_enterprise_baseline v1.1] Terraform-managed."
  order                      = var.rule_starting_order + 5
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  dlp_engines {
    id = [zia_dlp_engines.zbp_us_pii.id]
  }
  dynamic "email_tenants" {
    for_each = length(lookup(var.email_tenant_ids, "ZBP-US PII [Email]", var.email_tenant_ids_default)) > 0 ? [1] : []
    content {
      id = lookup(var.email_tenant_ids, "ZBP-US PII [Email]", var.email_tenant_ids_default)
    }
  }
}

