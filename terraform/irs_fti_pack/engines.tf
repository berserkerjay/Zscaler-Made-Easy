# Generated by Zscaler Made Easy from pack irs_fti_pack v1.0 for zscaler/zia ~> 4.8.

# Engines — expressions reference dictionaries by resource, or by data lookup for predefined ones.

resource "zia_dlp_engines" "fti_markings" {
  name              = "FTI Markings"
  description       = "Documents labelled as federal tax information (the IRC 6103 citation or the words Federal Tax Information). [${var.assessor} pack irs_fti_pack v1.0] Terraform-managed."
  custom_dlp_engine = true
  engine_expression = "((D${zia_dlp_dictionaries.fti_markings.id}.S > 0))"
}

resource "zia_dlp_engines" "fti_return_data" {
  name              = "FTI Return Data"
  description       = "A tax form or transcript name with a Social Security or taxpayer identification number within 500 characters. [${var.assessor} pack irs_fti_pack v1.0] Terraform-managed."
  custom_dlp_engine = true
  engine_expression = "((D${zia_dlp_dictionaries.fti_tax_forms.id}.S > 0) AND ((D${zia_dlp_dictionaries.fti_social_security_numbers_us_prox_500.id}.S > 0) OR (D${zia_dlp_dictionaries.fti_tax_identification_number_us_prox_500.id}.S > 0)))"
}

