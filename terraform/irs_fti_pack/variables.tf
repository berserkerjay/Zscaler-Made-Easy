# Generated by Zscaler Made Easy from pack irs_fti_pack v1.0 for zscaler/zia ~> 4.8.

variable "zscaler_client_id" {
  description = "OneAPI client ID. Leave null to use ZSCALER_CLIENT_ID."
  type        = string
  default     = null
  sensitive   = true
}

variable "zscaler_client_secret" {
  description = "OneAPI client secret. Leave null to use ZSCALER_CLIENT_SECRET."
  type        = string
  default     = null
  sensitive   = true
}

variable "zscaler_vanity_domain" {
  description = "ZIdentity vanity domain (acme for acme.zslogin.net). Leave null to use ZSCALER_VANITY_DOMAIN."
  type        = string
  default     = null
}

variable "zscaler_cloud" {
  description = "Leave null (or empty) for commercial production; beta, gov or govus otherwise. Env: ZSCALER_CLOUD."
  type        = string
  default     = null
}

variable "rule_starting_order" {
  description = "Order given to the first NEW rule of each channel; further new rules follow contiguously. Existing rules imported in gap mode keep their current order."
  type        = number
  default     = 1
  nullable    = false

  validation {
    condition     = var.rule_starting_order >= 1 && floor(var.rule_starting_order) == var.rule_starting_order
    error_message = "rule_starting_order must be a whole number of 1 or more."
  }
}

variable "policy_rank" {
  description = "Admin rank for the rules (0-7). 0 takes precedence over rules made by lower-ranked admins."
  type        = number
  default     = 7
  nullable    = false

  validation {
    condition     = var.policy_rank >= 0 && var.policy_rank <= 7 && floor(var.policy_rank) == var.policy_rank
    error_message = "policy_rank must be a whole number from 0 to 7."
  }
}

variable "activate" {
  description = "Activate pending ZIA changes after apply (zia_activation_status)."
  type        = bool
  default     = true
  nullable    = false
}

variable "saas_tenant_ids" {
  description = "Onboarded SaaS Security API tenant ids per rule name (Administration > SaaS Application Tenants) for the SaaS Security API rules whose tenants the pack does not name; a rule not listed here uses saas_tenant_ids_default. Run a preflight in Zscaler Made Easy to have them resolved by name instead."
  type        = map(list(number))
  default     = {}
  nullable    = false
}

variable "saas_tenant_ids_default" {
  description = "Onboarded SaaS Security API tenant ids for every SaaS Security API rule not listed in saas_tenant_ids."
  type        = list(number)
  default     = []
  nullable    = false
}

variable "email_tenant_ids" {
  description = "Onboarded outbound email tenant ids per rule name (Administration > SaaS Application Tenants) for the outbound email rules whose tenants the pack does not name; a rule not listed here uses email_tenant_ids_default. Run a preflight in Zscaler Made Easy to have them resolved by name instead."
  type        = map(list(number))
  default     = {}
  nullable    = false
}

variable "email_tenant_ids_default" {
  description = "Onboarded outbound email tenant ids for every outbound email rule not listed in email_tenant_ids."
  type        = list(number)
  default     = []
  nullable    = false
}

variable "assessor" {
  description = "The assessor's name each object's description carries ([<assessor> pack <id> v<version>]). Required: name the person who assesses and deploys the pack, never the tool."
  type        = string
  nullable    = false

  validation {
    condition     = length(trimspace(var.assessor)) > 0 && length(var.assessor) <= 40 && length(regexall("[\\[\\]]", var.assessor)) == 0 && length(regexall("(?i)dlp[\\W_]*check|zscaler[\\W_]*made[\\W_]*easy", var.assessor)) == 0
    error_message = "Name the assessor (at most 40 characters, no brackets, not the tool): it is part of every object's description."
  }
}

