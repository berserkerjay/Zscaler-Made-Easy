# Generated by Zscaler Made Easy from pack irs_fti_pack v1.0 for zscaler/zia ~> 4.8.

# Dictionaries — generated from the pack; predefined Zscaler dictionaries are looked up by name.

data "zia_dlp_dictionaries" "social_security_numbers_us" {
  name = "Social Security Numbers (US)"
}

data "zia_dlp_dictionaries" "usitin_leakage" {
  name = "USITIN_LEAKAGE"
}

resource "zia_dlp_dictionaries" "fti_markings" {
  name                     = "FTI-Markings"
  description              = "Federal tax information labels: the 26 U.S.C. 6103 / IRC 6103 citation and the words Federal Tax Information. [${var.assessor} pack irs_fti_pack v1.0] Terraform-managed."
  dictionary_type          = "PATTERNS_AND_PHRASES"
  custom                   = true
  custom_phrase_match_type = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b(?:IRC|I\\.R\\.C\\.|26\\s?U\\.?\\s?S\\.?\\s?C\\.?)\\s*(?:§{1,2}\\s*|SEC(?:TION|\\.)?\\s*)?6103\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\bFEDERAL\\s+TAX\\s+INFORMATION\\b"
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_ALL"
    phrase = "\"FEDERAL TAX INFORMATION\""
  }
}

resource "zia_dlp_dictionaries" "fti_tax_forms" {
  name                     = "FTI-Tax-Forms"
  description              = "Names of IRS returns, information returns and transcripts that carry return information. [${var.assessor} pack irs_fti_pack v1.0] Terraform-managed."
  dictionary_type          = "PATTERNS_AND_PHRASES"
  custom                   = true
  custom_phrase_match_type = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\bForm\\s+(?:1040(?:-?(?:SR|NR|X|ES))?|W-?2|1099(?:-[A-Z]{1,4})?|941|1120(?:-?S)?|1065|4506(?:-?[CT])?|8821)\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\b(?:Account|Record\\s+of\\s+Account|Wage\\s+and\\s+Income|Tax\\s+Return)\\s+Transcript\\b"
  }
  patterns {
    action  = "PATTERN_COUNT_TYPE_ALL"
    pattern = "\\bSchedule\\s+K-1\\b"
  }
  phrases {
    action = "PHRASE_COUNT_TYPE_UNIQUE"
    phrase = "\"adjusted gross income\""
  }
}

resource "zia_dlp_dictionaries" "fti_social_security_numbers_us_prox_500" {
  name                                 = "FTI-Social Security Numbers (US) - Prox 500"
  description                          = "Cloned predefined SSN dictionary with 500-character proximity, used WITH the tax form names so only SSNs in return data fire. [${var.assessor} pack irs_fti_pack v1.0] Terraform-managed."
  dictionary_type                      = "PATTERNS_AND_PHRASES"
  custom                               = true
  custom_phrase_match_type             = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  dict_template_id                     = data.zia_dlp_dictionaries.social_security_numbers_us.id
  confidence_level_for_predefined_dict = "CONFIDENCE_LEVEL_HIGH"
  confidence_threshold                 = "CONFIDENCE_LEVEL_HIGH"
  proximity                            = 500
}

resource "zia_dlp_dictionaries" "fti_tax_identification_number_us_prox_500" {
  name                                 = "FTI-Tax Identification Number (US) - Prox 500"
  description                          = "Cloned predefined US taxpayer identification number dictionary with 500-character proximity, used WITH the tax form names. [${var.assessor} pack irs_fti_pack v1.0] Terraform-managed."
  dictionary_type                      = "PATTERNS_AND_PHRASES"
  custom                               = true
  custom_phrase_match_type             = "MATCH_ANY_CUSTOM_PHRASE_PATTERN_DICTIONARY"
  dict_template_id                     = data.zia_dlp_dictionaries.usitin_leakage.id
  confidence_level_for_predefined_dict = "CONFIDENCE_LEVEL_MEDIUM"
  confidence_threshold                 = "CONFIDENCE_LEVEL_HIGH"
  proximity                            = 500
  include_bin_numbers                  = true
  # include_ssn_numbers = true  (not supported by the zscaler/zia provider; set in the portal)
}

