  dlp_engines {
    id = [zia_dlp_engines.ca_pipeda_personal_information.id]
  }
}

resource "zia_casb_dlp_rules" "ca_pipeda_personal_info_saas" {
  name                       = "CA-PIPEDA-Personal-Info [SaaS]"
  description                = "SaaS DLP: the same detection as the inline rule \"CA-PIPEDA-Personal-Info-Monitor\" (CA PIPEDA Personal Information). Monitor-only; enable after reviewing incidents. [${var.assessor} pack canada_privacy_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "OFLCASB_DLP_REPORT_INCIDENT"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  type                       = "OFLCASB_DLP_FILE"
  collaboration_scope        = ["ANY"]
  dlp_engines {
    id = [zia_dlp_engines.ca_pipeda_personal_information.id]
  }
  cloud_app_tenants {
    id = lookup(var.saas_tenant_ids, "CA-PIPEDA-Personal-Info [SaaS]", var.saas_tenant_ids_default)
  }
  lifecycle {
    precondition {
      condition     = length(lookup(var.saas_tenant_ids, "CA-PIPEDA-Personal-Info [SaaS]", var.saas_tenant_ids_default)) > 0
      error_message = "Rule CA-PIPEDA-Personal-Info [SaaS]: set saas_tenant_ids[\"CA-PIPEDA-Personal-Info [SaaS]\"] or saas_tenant_ids_default to the ids of the onboarded SaaS application tenants (Administration > SaaS Application Tenants), or run a preflight in Zscaler Made Easy to have them resolved by name."
    }
  }
}

