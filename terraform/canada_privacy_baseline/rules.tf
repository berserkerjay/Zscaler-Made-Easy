resource "zia_dlp_web_rules" "ca_pipeda_personal_info_monitor" {
  name                       = "CA-PIPEDA-Personal-Info-Monitor"
  description                = "Monitor outbound Canadian personal information: an identifier with a name or date-of-birth label. [${var.assessor} pack canada_privacy_baseline v1.0] Terraform-managed."
  order                      = var.rule_starting_order + 0
  rank                       = var.policy_rank
  state                      = "DISABLED"
  action                     = "ALLOW"
  severity                   = "RULE_SEVERITY_INFO"
  without_content_inspection = false
  protocols                  = ["WEBSOCKETSSL_RULE", "WEBSOCKET_RULE", "FTP_RULE", "HTTPS_RULE", "HTTP_RULE"]
  dlp_engines {
    id = [zia_dlp_engines.ca_pipeda_personal_information.id]
  }
}

