resource "zia_endpoint_dlp_rules" "ca_pipeda_personal_info_endpoint" {
  name                       = "CA-PIPEDA-Personal-Info [Endpoint]"
  description                = "Endpoint DLP: the same detection as the inline rule \"CA-PIPEDA-Personal-Info-Monitor\" (CA PIPEDA Personal Information). Monitor-only; enable after reviewing incidents. [${var.assessor} pack canada_privacy_baseline v1.0] Terraform-managed."
