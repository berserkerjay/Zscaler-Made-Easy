# Machine-specific settings for ./start.sh (Linux / macOS). Copy to
# local_settings.env (git-ignored). Every line is optional; the Windows
# equivalent is local_settings.bat.example. The container reads the same
# variable names from a .env file next to docker-compose.yml.

# Where the app listens. Keep 127.0.0.1 unless you front it with an
# authenticating reverse proxy and TLS.
#ZSCALER_BIND_HOST=127.0.0.1
#ZSCALER_PORT=8000

# Open the browser automatically when the server starts (1) or not (0).
#ZSCALER_OPEN_BROWSER=1

# Allow the app to CHANGE the tenant (deploy / remove policy packs).
# Leave unset: the switch inside Deploy Policy Packs enables it per session.
#ENABLE_WRITE_ACTIONS=YES_I_UNDERSTAND

# Tenant credentials, so the connection form is pre-filled. You can also
# type them in the app or save a tenant profile; nothing here is required.
#ZSCALER_CLOUD=production
#ZSCALER_VANITY_DOMAIN=acme
#ZSCALER_CLIENT_ID=
#ZSCALER_CLIENT_SECRET=
# Classic ZIA API instead of a ZIdentity API client (tenants without ZIdentity; ZIA only):
#ZSCALER_AUTH_METHOD=legacy
#ZSCALER_USERNAME=
#ZSCALER_PASSWORD=
#ZSCALER_API_KEY=

# Corporate proxy and TLS inspection.
#HTTPS_PROXY=http://proxy.corp:8080
# Behind TLS inspection, trust the proxy's root certificate with
# REQUESTS_CA_BUNDLE (or put the .pem in certs/ for the container).
#REQUESTS_CA_BUNDLE=/etc/ssl/certs/corporate-root.pem
#ZSCALER_UPDATE_PROXY=http://proxy.corp:8080
# Last resort only: 0 makes the update and documentation checks accept any
# certificate, so anyone on the network path can feed them false content.
#ZSCALER_UPDATE_VERIFY_TLS=0

# Beacon: how often (in hours) the server re-checks the Zscaler SDK, the
# ZIA API and the Terraform provider for changes while it runs. Default 24;
# 0 turns the timer off (Run now on the Beacon tab still works). The timer
# never reads a tenant. DLP_CHECK_BEACON_STATE moves the history file
# (default: beside the update-check cache, e.g. ~/.cache/zscaler_assessment).
#DLP_CHECK_BEACON_HOURS=24
#DLP_CHECK_BEACON_STATE=/path/to/beacon_state.json

# Continuous evaluation (the Digest) reads tenants, and every read counts
# against the ZIA API rate limit, so it runs only when you click Run the loop
# now. Set a number of hours to opt in to a timer; unset or 0 is off.
#DLP_CHECK_CONTINUOUS_EVAL_HOURS=0

# Show tracebacks and request logs while troubleshooting.
#ZSCALER_DEBUG=1
